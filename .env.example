# --- App ---
APP_NAME=travel-agent
ENVIRONMENT=local
API_V1_PREFIX=/api/v1

# --- Database ---
DATABASE_URL=postgresql+asyncpg://travel:travel@localhost:5432/travel_db
# Sync URL for Alembic
SYNC_DATABASE_URL=postgresql+psycopg2://travel:travel@localhost:5432/travel_db

# --- Auth ---
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --- LLM ---
# Leave both empty to use the built-in template fallback (works without a key).
# Groq (OpenAI-compatible). Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Force provider: auto (default) | groq | openai
LLM_PROVIDER=auto
# OpenAI (alternative)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=60
